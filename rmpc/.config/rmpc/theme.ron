#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    default_album_art_path: None,

    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",

    browser_column_widths: [21, 38, 42],

    background_color: None,
    text_color: Some("#c1caf5"),
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: true,

    preview_label_style: (
        fg: "#8aa2f7",
        modifiers: "Bold",
    ),

    preview_metadata_group_style: (
        fg: "#bb10af",
        modifiers: "Bold",
    ),

    tab_bar: (
        active_style: (
            fg: "#2a1b26",
            bg: "#8aa2f7",
            modifiers: "Bold",
        ),
        inactive_style: (
            fg: "#566f89",
        ),
    ),

    highlighted_item_style: (
        fg: "#8aa2f7",
        modifiers: "Bold",
    ),

    current_item_style: (
        fg: "#2a1b26",
        bg: "#10ece6",
        modifiers: "Bold",
    ),

    borders_style: (
        fg: "#4b4261",
    ),

    highlight_border_style: (
        fg: "#8aa2f7",
    ),

    symbols: (
        song: "",
        dir: "",
        playlist: "",
        marker: "󰻭",
        ellipsis: "...",

        song_style: (
            fg: "#8dcfff",
        ),

        dir_style: (
            fg: "#8aa2f7",
        ),

        playlist_style: (
            fg: "#bb10af",
        ),
    ),

    level_styles: (
        info: (
            fg: "#8dcfff",
            // bg: "#2a1b26",
        ),
        warn: (
            fg: "#e1af68",
            // bg: "#2a1b26",
        ),
        error: (
            fg: "#f7769e",
            // bg: "#2a1b26",
        ),
        debug: (
            fg: "#10ece6",
            // bg: "#2a1b26",
        ),
        trace: (
            fg: "#bb10af",
            // bg: "#2a1b26",
        ),
    ),

    progress_bar: (
        symbols: ["[", "━", ">", " ", "]"],

        track_style: (
            fg: "#293e42",
        ),

        elapsed_style: (
            fg: "#8aa2f7",
        ),

        thumb_style: (
            fg: "#8dcfff",
            // bg: "#293e42",
        ),

        use_track_when_empty: false,
    ),

    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],

        track_style: (
            fg: "#293e42",
        ),

        ends_style: (
            fg: "#566f89",
        ),

        thumb_style: (
            fg: "#8aa2f7",
        ),
    ),

    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (
                    kind: Text("Unknown"),
                    style: (fg: "#f7769e")
                )
            ),
            width: "21%",
        ),

        (
            prop: (
                kind: Property(Title),
                default: (
                    kind: Text("Unknown"),
                    style: (fg: "#f7769e")
                )
            ),
            width: "36%",
        ),

        (
            prop: (
                kind: Property(Album),
                style: (fg: "#bb10af"),
                default: (
                    kind: Text("Unknown Album"),
                    style: (fg: "#f7769e")
                )
            ),
            width: "31%",
        ),

        (
            prop: (
                kind: Property(Duration),
                style: (fg: "#566f89"),
                default: (
                    kind: Text("-"),
                    style: (fg: "#566f89")
                )
            ),
            width: "16%",
            alignment: Right,
        ),
    ],

    components: {},

    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "3",
            ),
            (
                pane: Pane(Tabs),
                size: "4",
            ),
            (
                pane: Pane(TabContent),
                size: "101%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "2",
            ),
        ],
    ),

    header: (
        rows: [
            (
                left: [
                    (
                        kind: Text("["),
                        style: (
                            fg: "#8aa2f7",
                            modifiers: "Bold",
                        )
                    ),

                    (
                        kind: Property(
                            Status(
                                StateV2(
                                    playing_label: "Playing",
                                    paused_label: "Paused",
                                    stopped_label: "Stopped",
                                    )
                                )
                        ),
                        style: (
                            fg: "#8aa2f7",
                            modifiers: "Bold",
                        )
                    ),

                    (
                        kind: Text("]"),
                        style: (
                            fg: "#8aa2f7",
                            modifiers: "Bold",
                        )
                    )
                ],

                center: [
                    (
                        kind: Property(Song(Title)),
                        style: (
                            modifiers: "Bold",
                            fg: "#c1caf5",
                        ),
                        default: (
                            kind: Text("No Song"),
                            style: (
                                modifiers: "Bold",
                                fg: "#566f89",
                            )
                        )
                    )
                ],

                right: [
                    (
                        kind: Property(Widget(ScanStatus)),
                        style: (
                            fg: "#8dcfff",
                        )
                    ),

                    (
                        kind: Property(Widget(Volume)),
                        style: (
                            fg: "#8dcfff",
                        )
                    )
                ]
            ),

            (
                left: [
                    (
                        kind: Property(Status(Elapsed)),
                        style: (fg: "#8aa2f7")
                    ),
                    (
                        kind: Text(" / "),
                        style: (fg: "#566f89")
                    ),
                    (
                        kind: Property(Status(Duration)),
                        style: (fg: "#8aa2f7")
                    ),
                    (
                        kind: Text(" ("),
                        style: (fg: "#566f89")
                    ),
                    (
                        kind: Property(Status(Bitrate)),
                        style: (fg: "#8dcfff")
                    ),
                    (
                        kind: Text(" kbps)"),
                        style: (fg: "#566f89")
                    )
                ],

                center: [
                    (
                        kind: Property(Song(Artist)),
                        style: (
                            fg: "#8dcfff",
                            modifiers: "Bold",
                        ),
                        default: (
                            kind: Text("Unknown"),
                            style: (
                                fg: "#f7769e",
                                modifiers: "Bold",
                            )
                        )
                    ),

                    (
                        kind: Text(" - "),
                        style: (fg: "#566f89")
                    ),

                    (
                        kind: Property(Song(Album)),
                        style: (fg: "#bb10af"),
                        default: (
                            kind: Text("Unknown Album"),
                            style: (fg: "#f7769e")
                        )
                    )
                ],

                right: [
                    (
                        kind: Property(
                            Widget(
                                States(
                                    active_style: (
                                        fg: "#10ece6",
                                        modifiers: "Bold",
                                    ),
                                    separator_style: (
                                        fg: "#566f89"
                                    )
                                )
                            )
                        ),
                        style: (
                            fg: "#566f89"
                        )
                    ),
                ]
            ),
        ],
    ),

    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (
                    kind: Text(" ")
                ),
            ])
        ),

        (
            kind: Group([
                (kind: Property(Artist)),
                (
                    kind: Text(" - "),
                    style: (fg: "#566f89")
                ),
                (kind: Property(Title)),
            ]),

            default: (
                kind: Property(Filename),
                style: (fg: "#8dcfff")
            )
        ),
    ],

    lyrics: (
        timestamp: false
    )
)
